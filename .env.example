# ---------------------------------------------------------------------------
# Webapp environment variables
# Copy this file to `.env.local` and fill in the values you need.
# Never commit `.env.local`.
# ---------------------------------------------------------------------------

# GitHub notes repository (required)
# Create a fine-grained Personal Access Token with "Contents: Read and write"
# access to the repository that will store your Markdown notes.
GITHUB_TOKEN=""
GITHUB_USER=""
GITHUB_REPO=""

# Public URL of this deployment (optional)
# Used for canonical links and Open Graph metadata only.
# Example: https://notes.example.com
APP_URL=""

# Optional access gate (strongly recommended for any deployment with real notes)
# When set, every route requires HTTP Basic authentication with this password
# and APP_USERNAME (default: webapp). Requires HTTPS.
APP_PASSWORD=""
APP_USERNAME=""

# Search engine indexing (leave empty for a private deployment)
# Only set to "true" for a public demo instance that uses sample notes.
ALLOW_INDEXING=""

# AI providers (all optional)
# Configure only the providers you want to use. The keys are read on the server
# and are never exposed to the browser.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""

# Custom or local OpenAI-compatible endpoint (optional)
# Works with Ollama, LM Studio, vLLM, OpenRouter, Together, etc.
CUSTOM_AI_BASE_URL=""
CUSTOM_AI_API_KEY=""
CUSTOM_AI_MODEL=""
